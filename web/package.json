{
  "name": "portfolio-template",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "scaffold": "node scripts/scaffold.js",
    "reset": "node scripts/reset.js",
    "dev": "node scripts/scaffold.js --if-needed && node style-dictionary.config.js && vite",
    "build": "node style-dictionary.config.js && tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.13.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "style-dictionary": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
